# Normalize text files so Windows and WSL do not create line-ending-only diffs.
* text=auto

*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.hpp     text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.svg     text eol=lf
*.sh      text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
