{
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.debugConfig": {
        "type": "cppdbg",
        "cwd": "${workspaceFolder}",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "targetArchitecture": "x64",
        "debuginfod": {
            "enabled": false
        },
        "externalConsole": false,
        "args": [
            "--physical-demo"
        ],
        "setupCommands": [
            {
                "description": "Enable GDB pretty printing",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    }
}
